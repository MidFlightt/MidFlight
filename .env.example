# Copy to .env (git-ignored) and fill in. Never commit real values.
# What each setting means: midflight/config.py

# Where the server is reached. Locally:
MIDFLIGHT_PUBLIC_URL=http://127.0.0.1:8000

# Local development without GitHub secrets: sign in through a simple form instead.
# Remove this line to use real Sign in with GitHub.
MIDFLIGHT_DEV_LOGIN=1

# The MidFlight Team Yoga GitHub App (public values).
MIDFLIGHT_GITHUB_CLIENT_ID=Iv23li5CstbOq7OMWVjO
MIDFLIGHT_GITHUB_APP_ID=5233457

# Secrets: from the GitHub App's settings page. Keep them in a password manager.
MIDFLIGHT_GITHUB_CLIENT_SECRET=
MIDFLIGHT_GITHUB_PRIVATE_KEY_PATH=
MIDFLIGHT_GITHUB_WEBHOOK_SECRET=

# The AI reviewer on Amazon Bedrock. Leave empty for rules only (needs AWS credentials).
# MIDFLIGHT_REVIEWER_MODEL=us.anthropic.claude-sonnet-5-5
